# ── 서버 전용 (절대 클라이언트에 노출 금지) ──────────────────────
# Anthropic API 키. Vercel 대시보드 > Project > Settings > Environment Variables 에 등록.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# 판정/롤플레이 모델. 기본은 품질 우선 opus-4-8.
# 트래픽 확장 시 COGS 절감을 위해 claude-haiku-4-5 로 교체 검토 (docs/MONETIZATION_KPI.md).
MODEL=claude-opus-4-8

# 하루 무료 라운드 수 (클라 표시/서버 참고값)
FREE_ROUNDS_PER_DAY=5

# 라운드당 최대 턴 수
MAX_TURNS=6

# ── 선택: 프로덕션 영속화/광고/결제 (스텁 → 실연동 자리) ───────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# STRIPE_SECRET_KEY=sk_test_xxx        # 테스트 모드
# VITE_AD_NETWORK_ID=                  # 보상형 광고 SDK (클라 노출 가능 ID)

# ── 클라이언트 노출 가능 (VITE_ 접두사) ──────────────────────────
# 배포 도메인 (공유 링크/OG 절대경로 생성용). 비우면 현재 origin 사용.
VITE_PUBLIC_BASE_URL=
